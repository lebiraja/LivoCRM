# Copy this file to .env on the server, then replace every REPLACE_* value.
# Keep .env readable only by root and the deployment operator (chmod 600).

POSTGRES_USER=livocrm_user
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX_PASSWORD
POSTGRES_DB=livocrm
DATABASE_URL=postgresql+asyncpg://livocrm_user:REPLACE_WITH_RANDOM_HEX_PASSWORD@db:5432/livocrm

REDIS_PASSWORD=REPLACE_WITH_DIFFERENT_RANDOM_HEX_PASSWORD
REDIS_URL=redis://:REPLACE_WITH_DIFFERENT_RANDOM_HEX_PASSWORD@redis:6379/0
REDIS_MAXMEMORY=128mb

SECRET_KEY=REPLACE_WITH_OPENSSL_RAND_HEX_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
AUTH_COOKIE_SECURE=true
ALLOW_REGISTRATION=false

# Cloudflare Tunnel token (Zero Trust > Networks > Tunnels). Used by the cloudflared service only.
TUNNEL_TOKEN=REPLACE_WITH_CLOUDFLARE_TUNNEL_TOKEN
APP_DOMAIN=livocrm.lebiraja.in
CORS_ORIGINS=https://livocrm.lebiraja.in
ENABLE_DOCS=false
LOG_LEVEL=INFO
ENABLE_SCHEDULER=false

# Required for AI features. Leave empty only if you want rule-based fallback responses.
LLM_PROVIDER=groq
GROQ_API_KEYS=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL_FAST=openai/gpt-oss-20b
GROQ_MODEL_SMART=openai/gpt-oss-120b
LLM_TIMEOUT_S=15
LLM_TEMPERATURE=0.2
