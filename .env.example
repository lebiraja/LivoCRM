# ── LivoCRM Environment Variables ──
# Copy to .env and replace every change-me (e.g. `openssl rand -hex 32`).

# Database
POSTGRES_USER=livocrm_user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=livocrm
DATABASE_URL=postgresql+asyncpg://livocrm_user:change-me@db:5432/livocrm

# Redis (password required; URL must embed the same password)
REDIS_PASSWORD=change-me
REDIS_URL=redis://:change-me@redis:6379/0
REDIS_MAXMEMORY=128mb

# Auth
SECRET_KEY=change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# HTTP
CORS_ORIGINS=http://localhost:3500,http://localhost:5173
ENABLE_DOCS=false
LOG_LEVEL=INFO

# Recovery engine: in-process 60 s follow-up generator (keep false with several workers)
ENABLE_SCHEDULER=false

# pgAdmin (dev profile only)
PGADMIN_DEFAULT_EMAIL=admin@livocrm.com
PGADMIN_DEFAULT_PASSWORD=change-me

# AWS Bedrock (for AI features)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
BEDROCK_LLM_MODEL=us.meta.llama4-scout-17b-instruct-v1:0

# Frontend
VITE_API_URL=http://localhost:8000
