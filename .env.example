# ── LivoCRM Environment Variables ──

# Database
POSTGRES_USER=livocrm_user
POSTGRES_PASSWORD=supersecretpassword
POSTGRES_DB=livocrm
DATABASE_URL=postgresql+asyncpg://livocrm_user:supersecretpassword@db:5432/livocrm

# Auth
SECRET_KEY=change-me-to-a-64-char-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# AWS Bedrock (for AI features)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
BEDROCK_LLM_MODEL=us.meta.llama4-scout-17b-instruct-v1:0

# Frontend
VITE_API_URL=http://localhost:8000
